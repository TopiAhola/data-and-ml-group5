   "source": [
    "### 4. Modeling OLD\n",
    "Since raw accident records represent single events, direct continuous linear modeling on row levels is mathematically invalid. We perform an **Aggregation step** to compute total accidents grouped by month, establishing a true continuous numeric target variable suitable for Linear Regression modeling."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 158,
   "id": "dd0f7c48d93d2004",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-10-08T11:54:03.389592900Z",
     "start_time": "2026-10-08T11:54:03.265746900Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " --- Linear Regression Evaluation Model Results ---\n",
      "Model Intercept (b0 - Base Baseline): 166.82\n",
      "Model Coefficient (b1 - Slope Weighted): 10.34\n",
      "Mean Absolute Error (MAE): 48.86 accidents\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# 5. Data Preparation: Aggregate total accidents by month (kkonn)\n",
    "monthly_df = accidents_gdf.groupby('kuukausi').size().reset_index(name='accidents_count')\n",
    "\n",
    "# 6. Define Linear Regression variables\n",
    "X = monthly_df[['kuukausi']]          # Explanatory variable (Month index)\n",
    "y = monthly_df['accidents_count']  # Continuous numeric target\n",
    "\n",
    "# 7. Train the Linear Regression Engine\n",
    "reg_model = LinearRegression()\n",
    "reg_model.fit(X, y)\n",
    "\n",
    "# 8. Phase 5: Evaluation - Calculate MAE to measure average prediction error\n",
    "y_pred = reg_model.predict(X)\n",
    "mae_error = mean_absolute_error(y, y_pred)\n",
    "\n",
    "print(\" --- Linear Regression Evaluation Model Results ---\")\n",
    "print(f\"Model Intercept (b0 - Base Baseline): {reg_model.intercept_:.2f}\")\n",
    "print(f\"Model Coefficient (b1 - Slope Weighted): {reg_model.coef_[0]:.2f}\")\n",
    "print(f\"Mean Absolute Error (MAE): {mae_error:.2f} accidents\")\n",
    "\n",
    "# 9. Visualize the Linear Fit and distribution\n",
    "plt.figure(figsize=(10, 5))\n",
    "sns.barplot(data=monthly_df, x='kuukausi', y='accidents_count', color='skyblue', alpha=0.7, label='Actual Monthly Count')\n",
    "plt.plot(monthly_df['kuukausi'] - 1, y_pred, color='red', marker='o', linewidth=2, label='Linear Regression Fit')\n",
    "plt.title('Road Traffic Accidents Linear Model Fit by Month', fontsize=12, fontweight='bold')\n",
    "plt.xlabel('Month of the Year')\n",
    "plt.ylabel('Total Accidents')\n",
    "plt.legend()\n",
    "plt.grid(axis='y', alpha=0.3)\n",
    "plt.show()"
   ]
  },
