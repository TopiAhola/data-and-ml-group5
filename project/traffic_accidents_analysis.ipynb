   "source": [
    "### 5.X Feature Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 109,
   "id": "28660d16f6bc34bb",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-10-08T14:11:49.290245200Z",
     "start_time": "2026-10-08T14:11:49.031493700Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
